# Supabase Configuration
# Copie ce fichier vers .env et remplis les valeurs avec tes credentials Supabase

# Project URL - Tu le trouves dans Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Anon/Public Key - Tu le trouves dans Settings → API
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxx

# Service Role Key (optionnel) - Pour les scripts migrate-notifications, upload-covers
# Tu le trouves dans Settings → API → service_role
# ⚠️ Ne JAMAIS exposer cette clé côté client !
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxx

# Database URL (optionnel) - Pour le script fix-search-path (correction Security Advisor)
# Supabase → Settings → Database → Connection string (mode Transaction)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@xxx.pooler.supabase.com:6543/postgres

# Note: Ne commit JAMAIS le fichier .env dans git!
# Il contient tes credentials privés.
